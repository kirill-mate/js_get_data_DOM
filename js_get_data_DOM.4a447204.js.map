'use strict';
var allData = document.querySelectorAll('.population');
var avarage = document.querySelector('.average-population');
var total = document.querySelector('.total-population');
var allDataToNum = [];
allData.forEach(function(country) {
    allDataToNum.push(Number(country.textContent.replace(/,/g, '')));
});
var totalValue = allDataToNum.reduce(function(sum, value) {
    return sum + value;
}, 0);
var averageValue = totalValue / allDataToNum.length;
total.textContent = totalValue.toLocaleString();
avarage.textContent = averageValue.toLocaleString();

